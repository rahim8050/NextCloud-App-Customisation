{
	"name": "nextcloud/weather_apis",
	"description": "Nextcloud Weather APIs app",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"require-dev": {
		"nextcloud/coding-standard": "^1.3",
		"nextcloud/ocp": "dev-stable32",
		"phpunit/phpunit": "^9",
		"vimeo/psalm": "^5.15"
	},
	"config": {
		"optimize-autoloader": true,
		"classmap-authoritative": true,
		"platform": {
			"php": "8.1"
		},
		"sort-packages": true
	},
	"autoload-dev": {
		"psr-4": {
			"OCP\\": "vendor/nextcloud/ocp/OCP"
		}
	},
	"scripts": {
		"lint:php": "find . -name \\*.php -not -path './vendor/*' -not -path './vendor-bin/*' -not -path './build/*' -print0 | xargs -0 -r -n1 php -l",
		"lint": "@lint:php",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"stan": "psalm --no-cache --threads=1 --config=psalm.xml",
		"psalm": "@stan",
		"test": "phpunit -c tests/phpunit.xml --colors=always",
		"test:unit": "@test"
	}
}
